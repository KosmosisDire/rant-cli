include("${CMAKE_CURRENT_LIST_DIR}/lib.cmake")

# A home set up the way the installers and setup leave it, beside the user's own lines.
set(home "${SCRATCH}/home")
set(ENV{HOME} "${home}")
set(ENV{XDG_CONFIG_HOME} "${home}/.config")
file(WRITE "${home}/.bashrc" "alias ll='ls -l'\n")
rant(setup bash)
file(APPEND "${home}/.bashrc" "\nexport PATH=\"${home}/.rant/bin:$PATH\"    # rant-cli\n")
file(WRITE "${home}/.config/fish/conf.d/rant.fish" "fish_add_path -g \"${home}/.rant/bin\"    # rant-cli\n")
file(WRITE "${home}/.config/fish/conf.d/other.fish" "set -g x 1\n")
file(MAKE_DIRECTORY "${home}/.claude")
file(WRITE "${SCRATCH}/tool/package.rant" "name = \"tool\"\n")
file(WRITE "${SCRATCH}/tool/skill/SKILL.md" "---\nname: tool\n---\n")
rant(install tool --from tool)
file(WRITE "${home}/.rant/packages/explorer/package.rant" "description = \"The explorer\"\n")

rant(uninstall)
expect_match("${OUT}" "removing:\n")
expect_match("${OUT}" "[.]bashrc [(]its rant lines[)]\n")
expect_match("${OUT}" "conf[.]d.rant[.]fish\n")
expect_match("${OUT}" "[.]claude.skills.tool [(]the tool skill[)]\n")
expect_match("${OUT}" "Workspaces stay as they are")
expect_match("${OUT}" "uninstalled rant-cli\n")

# Only rant's own lines and files went.
file(READ "${home}/.bashrc" bashrc)
expect_match("${bashrc}" "^alias ll='ls -l'\n$")
foreach(gone "${home}/.rant" "${home}/.claude/skills/tool" "${home}/.config/fish/conf.d/rant.fish")
  if(EXISTS "${gone}")
    message(FATAL_ERROR "${gone} is still there")
  endif()
endforeach()
foreach(kept "${home}/.claude" "${home}/.config/fish/conf.d/other.fish" "${SCRATCH}/tool/skill/SKILL.md")
  if(NOT EXISTS "${kept}")
    message(FATAL_ERROR "${kept} was removed")
  endif()
endforeach()

rant(uninstall)
expect_match("${OUT}" "^rant-cli left nothing here to remove\n$")

# The bridge config holds the user's passphrase, so it stays when the rest goes. No login
# entry names this home, so the real one stays untouched.
file(WRITE "${home}/.rant/bridge.yaml" "passphrase: secret\n")
file(WRITE "${home}/.rant/packages/bridge/package.rant" "name = \"bridge\"\n")
rant(uninstall)
expect_match("${OUT}" "[.]rant\n")
expect_match("${OUT}" "bridge[.]yaml stays, it holds your bridge passphrase and settings")
file(GLOB left "${home}/.rant/*")
list(LENGTH left count)
if(NOT count EQUAL 1 OR NOT EXISTS "${home}/.rant/bridge.yaml")
  message(FATAL_ERROR "expected only bridge.yaml to stay, got: ${left}")
endif()
rant(uninstall)
expect_match("${OUT}" "^rant-cli left nothing here to remove\n$")
file(REMOVE_RECURSE "${home}/.rant")

# A RANT_HOME not named .rant is never deleted whole.
set(ENV{RANT_HOME} "${home}")
rant(uninstall FAILS)
expect_match("${ERR}" "uninstall only removes a folder named [.]rant")
