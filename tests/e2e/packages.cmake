include("${CMAKE_CURRENT_LIST_DIR}/lib.cmake")

# A package as its repo builds it: package.rant, a group and the program in bin/. Nothing here
# reaches the network: packages come from this folder, linked, or from an archive of it.
set(home "$ENV{RANT_HOME}")
set(build "${SCRATCH}/tool-build")
install_test_node("tool-build/bin" tool)
file(WRITE "${build}/package.rant" "name = \"tool\"\ndescription = \"A test tool\"\nnode \"worker\" {\n  run = [\"$\{path.package}/bin/tool\", \"--life\", \"60\"]\n}\n")
file(WRITE "${build}/Tool.run" "node \"tool/worker\" {}\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar czf "${SCRATCH}/tool.tar.gz" package.rant Tool.run bin
                WORKING_DIRECTORY "${build}" RESULT_VARIABLE packed)
if(NOT packed EQUAL 0)
  message(FATAL_ERROR "cannot pack the test archive")
endif()

# Usage mistakes.
rant(install FAILS)
expect_match("${ERR}" "install needs a package")
rant(install tool other --from tool.tar.gz FAILS)
expect_match("${ERR}" "--from takes one package")
rant(install tool --from tool.tar.gz --version 1.0 FAILS)
expect_match("${ERR}" "--version picks a release, and --from has none")
rant(install Tool --from tool.tar.gz FAILS)
expect_match("${ERR}" "`Tool` is no package name, which is lowercase letters, digits and _, and no GitHub repo")
rant(install someone/tool --from tool.tar.gz FAILS)
expect_match("${ERR}" "--from takes the name of the package it holds, not a repo")
rant(remove tool FAILS)
expect_match("${ERR}" "tool is not installed")
rant(install tool --from missing FAILS)
expect_match("${ERR}" "no folder or archive [^\n]*missing for tool")
file(WRITE "${SCRATCH}/empty/readme.md" "nothing\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar czf "${SCRATCH}/empty.tar.gz" readme.md WORKING_DIRECTORY "${SCRATCH}/empty")
rant(install tool --from empty.tar.gz FAILS)
expect_match("${ERR}" "holds no package[.]rant at its top")
if(EXISTS "${home}/packages/tool")
  message(FATAL_ERROR "a refused archive was installed")
endif()

# A package's own package.rant names it, so another name is refused.
rant(install other --from tool-build FAILS)
expect_match("${ERR}" "tool-build holds the package tool, not other")
rant(install other --from tool.tar.gz FAILS)
expect_match("${ERR}" "tool[.]tar[.]gz holds the package tool, not other")
file(GLOB left "${home}/packages/*" "${home}/packages/.*")
if(left)
  message(FATAL_ERROR "a refused name left ${left}")
endif()

# An archive unpacks into rant's home, and its nodes and groups count everywhere.
rant(install tool --from tool.tar.gz)
expect_match("${ERR}" "installed tool from [^\n]*tool[.]tar[.]gz")
file(READ "${home}/packages/tool.json" record)
expect_match("${record}" "\"named_by\": \"--from\"")
rant(ls packages)
expect_match("${OUT}" "\n  tool +package[.]rant +installed")
rant(run Tool)
expect_match("${OUT}" "worker +started")

# While its node runs it can neither go nor change.
rant(remove tool FAILS)
expect_match("${ERR}" "worker runs from tool, stop it first with `rant stop`")
rant(install tool --from tool.tar.gz FAILS)
expect_match("${ERR}" "worker runs from tool, stop it first")
rant(stop Tool)
rant(install tool --from tool.tar.gz)
rant(remove tool)
expect_match("${ERR}" "removed tool")
file(GLOB left "${home}/packages/*" "${home}/packages/.*")
if(left)
  message(FATAL_ERROR "remove left ${left}")
endif()

# sources.rant lists local build folders, relative to itself, which are linked, never copied,
# each named by its package.rant.
file(WRITE "${SCRATCH}/nameless/package.rant" "description = \"No name\"\n")
file(WRITE "${home}/sources.rant" "paths     = [\"../../tool-build\", \"../../nameless\"]\ndatabases = [\"someone/packages\"]\n")
rant(ls sources)
expect_match("${OUT}" "^SOURCES\n  [^\n]*/tool-build +path *\n  [^\n]*/nameless +path *\n  KosmosisDire/rant-packages +database +official\n  someone/packages +database *\n")
rant(install tool)
expect_match("${ERR}" "linked tool to [^\n]*tool-build")
rant(install nameless --from nameless FAILS)
expect_match("${ERR}" "the package[.]rant of [^\n]*nameless gives no name")
rant(info package tool)
expect_match("${OUT}" "\ndescription: A test tool\n")
file(WRITE "${build}/Later.run" "node \"tool/worker\" {}\n")
rant(ls groups)
expect_match("${OUT}" "tool/Later")
rant(remove tool)
if(NOT EXISTS "${build}/package.rant" OR NOT EXISTS "${build}/bin")
  message(FATAL_ERROR "removing a linked package reached into its folder")
endif()

# Update finds a linked folder current by itself, and follows sources.rant to an archive,
# then takes the archive again once it changes.
file(WRITE "${home}/sources.rant" "paths = [\"../../tool-build\"]\n")
rant(install tool)
rant(update tool)
expect_match("${OUT}" "^tool is up to date\n$")
file(WRITE "${home}/sources.rant" "paths = [\"../../tool.tar.gz\"]\n")
rant(update tool -y)
expect_match("${OUT}" "This updates:\n  tool, from [^\n]*tool[.]tar[.]gz\n")
expect_match("${ERR}" "installed tool from")
rant(update tool)
expect_match("${OUT}" "^tool is up to date\n$")
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1)
execute_process(COMMAND "${CMAKE_COMMAND}" -E touch "${SCRATCH}/tool.tar.gz")
rant(update tool -y)
expect_match("${ERR}" "installed tool from")

# An update stops the nodes running from the package and starts them again after.
rant(run Tool)
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1)
execute_process(COMMAND "${CMAKE_COMMAND}" -E touch "${SCRATCH}/tool.tar.gz")
rant(update tool -y)
expect_match("${ERR}" "stopped worker while tool changes.*installed tool from.*started worker again")
rant(ls nodes --no-mesh)
expect_match("${OUT}" "Tool:\n +worker\n")
rant(stop Tool)

# What --from installed stays until rant install says otherwise.
rant(install tool --from tool-build)
rant(update tool)
expect_match("${ERR}" "tool came from [^\n]*tool-build through --from, so update leaves it alone")
rant(update other FAILS)
expect_match("${ERR}" "other is not installed, `rant install other` installs it")
rant(remove tool)

# A package a repo's link installed is never replaced from elsewhere, nor the other way.
file(MAKE_DIRECTORY "${home}/packages/tool")
file(WRITE "${home}/packages/tool.json" "{ \"repo\": \"someone/tool\", \"named_by\": \"link\", \"version\": \"1.0\" }\n")
rant(install tool --from tool-build FAILS)
expect_match("${ERR}" "tool is installed from someone/tool, `rant remove tool` first to install it from [^\n]*tool-build")
rant(remove tool)

# A broken sources.rant says where.
file(WRITE "${home}/sources.rant" "paths = [\"\"]\n")
rant(install tool FAILS)
expect_match("${ERR}" "sources[.]rant:1:[0-9]+: a path must name a folder or an archive")
rant(ls sources FAILS)
expect_match("${ERR}" "a path must name a folder or an archive")

# A package's skill folder is linked for each AI coding agent found, and goes with it. A
# package that is more than a skill asks first, until its skill is given.
set(ENV{HOME} "${SCRATCH}/home")
set(ENV{XDG_CONFIG_HOME} "${SCRATCH}/home/.config")
file(REMOVE "${home}/sources.rant")
file(WRITE "${build}/skill/SKILL.md" "---\nname: tool\ndescription: Use the tool\n---\n")
rant(install tool --from tool-build)
expect_match("${ERR}" "found no AI coding agent here to give the skill of tool to")
file(MAKE_DIRECTORY "${SCRATCH}/home/.claude" "${SCRATCH}/home/.cursor")
rant(install tool --from tool-build)
expect_match("${ERR}" "Also give the skill of tool to Claude Code, Cursor[?] [[]y/N[]] y")
expect_match("${ERR}" "linked the skill of tool for Claude Code as [^\n]*[.]claude.skills.tool\n")
expect_match("${ERR}" "linked the skill of tool for Cursor as [^\n]*[.]agents.skills.tool\n")
file(READ "${SCRATCH}/home/.claude/skills/tool/SKILL.md" skill)
expect_match("${skill}" "^---\nname: tool\n")
file(READ "${home}/packages/tool.json" record)
expect_match("${record}" "\"skills\": [[]")
rant(install tool --from tool-build)
if(ERR MATCHES "linked the skill of tool|Also give")
  message(FATAL_ERROR "a skill already linked was asked for or linked again:\n${ERR}")
endif()
rant(remove tool)
foreach(gone "${SCRATCH}/home/.claude/skills/tool" "${SCRATCH}/home/.agents/skills/tool")
  if(EXISTS "${gone}")
    message(FATAL_ERROR "remove left ${gone}")
  endif()
endforeach()
if(NOT EXISTS "${build}/skill/SKILL.md")
  message(FATAL_ERROR "remove reached into the skill's folder")
endif()

# A package that is only a skill gives it without asking, linked with each _ as -.
file(WRITE "${SCRATCH}/lore/package.rant" "name = \"lore_skill\"\n")
file(WRITE "${SCRATCH}/lore/skill/SKILL.md" "---\nname: lore-skill\ndescription: Lore\n---\n")
rant(install lore_skill --from lore)
expect_no_match("${ERR}" "Also give")
expect_match("${ERR}" "linked the skill of lore_skill for Claude Code as [^\n]*[.]claude.skills.lore-skill\n")
rant(remove lore_skill)

# remove takes the skill rant add gave a library as well.
file(WRITE "${home}/skills/geometry/SKILL.md" "---\nname: geometry\n---\n")
file(WRITE "${home}/skills/geometry.json" "{\"repo\": \"someone/geometry\", \"version\": \"1.0.0\", \"links\": []}\n")
rant(remove geometry)
expect_match("${ERR}" "removed the skill of geometry")
foreach(gone "${home}/skills/geometry" "${home}/skills/geometry.json")
  if(EXISTS "${gone}")
    message(FATAL_ERROR "remove left ${gone}")
  endif()
endforeach()

# Uninstall drops a linked package without reaching into its folder.
rant(install tool --from tool-build)
expect_match("${ERR}" "linked tool to")
rant(uninstall)
expect_match("${OUT}" "uninstalled rant-cli\n")
if(EXISTS "${home}")
  message(FATAL_ERROR "uninstall left ${home}")
endif()
if(NOT EXISTS "${build}/package.rant" OR NOT EXISTS "${build}/bin")
  message(FATAL_ERROR "uninstall reached into a linked package's folder")
endif()
