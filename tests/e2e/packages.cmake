include("${CMAKE_CURRENT_LIST_DIR}/lib.cmake")

# A package as its repo builds it: package.rant, a group and the program in bin/. Nothing here
# reaches the network: packages come from this folder, linked, or from an archive of it.
set(home "$ENV{RANT_HOME}")
set(build "${SCRATCH}/tool-build")
install_test_node("tool-build/bin" tool)
file(WRITE "${build}/package.rant" "description = \"A test tool\"\narchive = \"tool-$\{version}-$\{platform}.tar.gz\"\nnode \"worker\" {\n  run = [\"$\{path.package}/bin/tool\", \"--life\", \"60\"]\n}\n")
file(WRITE "${build}/Tool.run" "node \"tool/worker\" {}\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar czf "${SCRATCH}/tool.tar.gz" package.rant Tool.run bin
                WORKING_DIRECTORY "${build}" RESULT_VARIABLE packed)
if(NOT packed EQUAL 0)
  message(FATAL_ERROR "cannot pack the test archive")
endif()

# Usage mistakes.
rant(install FAILS)
expect_match("${ERR}" "install needs a package")
rant(install tool other --from tool.tar.gz FAILS)
expect_match("${ERR}" "--from takes one package")
rant(install tool --from tool.tar.gz --version 1.0 FAILS)
expect_match("${ERR}" "--version picks a release, and --from has none")
rant(install Tool --from tool.tar.gz FAILS)
expect_match("${ERR}" "`Tool` is no package name")
rant(remove tool FAILS)
expect_match("${ERR}" "tool is not installed")
rant(install tool --from missing FAILS)
expect_match("${ERR}" "no folder or archive [^\n]*missing for tool")
file(WRITE "${SCRATCH}/empty/readme.md" "nothing\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar czf "${SCRATCH}/empty.tar.gz" readme.md WORKING_DIRECTORY "${SCRATCH}/empty")
rant(install tool --from empty.tar.gz FAILS)
expect_match("${ERR}" "holds no package[.]rant at its top")
if(EXISTS "${home}/packages/tool")
  message(FATAL_ERROR "a refused archive was installed")
endif()

# An archive unpacks into rant's home, and its nodes and groups count everywhere.
rant(install tool --from tool.tar.gz)
expect_match("${ERR}" "installed tool from [^\n]*tool[.]tar[.]gz")
file(READ "${home}/packages/tool.json" record)
expect_match("${record}" "\"once\": true")
rant(ls packages)
expect_match("${OUT}" "\n  tool +package[.]rant +installed")
rant(run Tool)
expect_match("${OUT}" "worker +started")

# While its node runs it can neither go nor change.
rant(remove tool FAILS)
expect_match("${ERR}" "worker runs from tool, stop it first with `rant stop`")
rant(install tool --from tool.tar.gz FAILS)
expect_match("${ERR}" "worker runs from tool, stop it first")
rant(stop Tool)
rant(install tool --from tool.tar.gz)
rant(remove tool)
expect_match("${ERR}" "removed tool")
file(GLOB left "${home}/packages/*" "${home}/packages/.*")
if(left)
  message(FATAL_ERROR "remove left ${left}")
endif()

# sources.rant names a local build folder, relative to itself, which is linked, never copied.
file(WRITE "${home}/sources.rant" "package \"tool\" {\n  path = \"../../tool-build\"\n}\ndatabase \"someone/packages\" {}\n")
rant(ls sources)
expect_match("${OUT}" "^SOURCES\n  tool +package +[^\n]*tool-build\n  KosmosisDire/rant-packages +database +official\n  someone/packages +database *\n")
rant(install tool)
expect_match("${ERR}" "linked tool to [^\n]*tool-build")
rant(info package tool)
expect_match("${OUT}" "\ndescription: A test tool\n")
file(WRITE "${build}/Later.run" "node \"tool/worker\" {}\n")
rant(ls groups)
expect_match("${OUT}" "tool/Later")
rant(remove tool)
if(NOT EXISTS "${build}/package.rant" OR NOT EXISTS "${build}/bin")
  message(FATAL_ERROR "removing a linked package reached into its folder")
endif()

# Update finds a linked folder current by itself, and follows sources.rant to an archive,
# then takes the archive again once it changes.
file(WRITE "${home}/sources.rant" "package \"tool\" {\n  path = \"../../tool-build\"\n}\n")
rant(install tool)
rant(update tool)
expect_match("${OUT}" "^tool is up to date\n$")
file(WRITE "${home}/sources.rant" "package \"tool\" {\n  path = \"../../tool.tar.gz\"\n}\n")
rant(update tool -y)
expect_match("${OUT}" "This updates:\n  tool, from [^\n]*tool[.]tar[.]gz\n")
expect_match("${ERR}" "installed tool from")
rant(update tool)
expect_match("${OUT}" "^tool is up to date\n$")
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1)
execute_process(COMMAND "${CMAKE_COMMAND}" -E touch "${SCRATCH}/tool.tar.gz")
rant(update tool -y)
expect_match("${ERR}" "installed tool from")

# What --from installed stays until rant install says otherwise.
rant(install tool --from tool-build)
rant(update tool)
expect_match("${ERR}" "tool came from [^\n]*tool-build through --from, so update leaves it alone")
rant(update other FAILS)
expect_match("${ERR}" "other is not installed, `rant install other` installs it")
rant(remove tool)

# A broken sources.rant says where.
file(WRITE "${home}/sources.rant" "package \"tool\" {}\n")
rant(install tool FAILS)
expect_match("${ERR}" "sources[.]rant:1:1: package `tool` needs `repo` or `path`")
rant(ls sources FAILS)
expect_match("${ERR}" "needs `repo` or `path`")

# Uninstall drops a linked package without reaching into its folder.
set(ENV{HOME} "${SCRATCH}/home")
set(ENV{XDG_CONFIG_HOME} "${SCRATCH}/home/.config")
file(REMOVE "${home}/sources.rant")
rant(install tool --from tool-build)
expect_match("${ERR}" "linked tool to")
rant(uninstall)
expect_match("${OUT}" "uninstalled rant-cli\n")
if(EXISTS "${home}")
  message(FATAL_ERROR "uninstall left ${home}")
endif()
if(NOT EXISTS "${build}/package.rant" OR NOT EXISTS "${build}/bin")
  message(FATAL_ERROR "uninstall reached into a linked package's folder")
endif()
